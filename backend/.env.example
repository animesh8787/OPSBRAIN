DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/opsbrain

# JSON array of allowed frontend origins. Defaults to ["http://localhost:3000"]
# if unset - override this in production with your real Vercel URL(s), e.g.:
# CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=

FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a Firebase service account JSON key file (recommended for local dev).
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Alternative to the file above: paste the service account JSON inline (handy for
# platforms like Render where you set env vars instead of shipping a file).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Object storage for uploaded PDFs. Required in production - Render's free tier
# has no persistent disk, so local storage doesn't survive a restart. Leave
# these blank for local development and uploads fall back to ./uploads on disk.
# Get these from Supabase Dashboard > Project Settings > API, and create a
# private Storage bucket (name must match SUPABASE_STORAGE_BUCKET).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Required. Embeddings run through HF's hosted Inference API, not a local
# model - loading it locally needs 500MB+ of RAM just for torch + weights,
# which alone exceeds Render's free-tier 512MB limit. Free token, read
# access is enough: huggingface.co/settings/tokens
HF_TOKEN=
